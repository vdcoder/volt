{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "native",
            "displayName": "Native (MSVC + Ultralight)",
            "description": "Build for native Windows debugging with Ultralight SDK via AppCore",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/native",
            "cacheVariables": {
                "VOLT_TARGET": "ULTRALIGHT",
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "PORT": "UltralightWin",
                "UL_D3D_DRIVER": "d3d11",
                "ALLINONE_BUILD": "OFF"
            }
        },
        {
            "name": "wasm",
            "displayName": "WebAssembly (Emscripten)",
            "description": "Build for WebAssembly using Emscripten toolchain",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/wasm",
            "cacheVariables": {
                "VOLT_TARGET": "EMSCRIPTEN",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "native-debug",
            "configurePreset": "native",
            "configuration": "Debug"
        },
        {
            "name": "native-release",
            "configurePreset": "native",
            "configuration": "Release"
        },
        {
            "name": "wasm-debug",
            "configurePreset": "wasm",
            "configuration": "Debug"
        },
        {
            "name": "wasm-release",
            "configurePreset": "wasm",
            "configuration": "Release"
        }
    ],
    "testPresets": []
}
